# =============================================================================
# Dockerfile.ultra — target ~270MB final image
# Removes: Remotion, Chromium, kokoro-js (uses external Kokoro API instead)
# Keeps:   whisper.cpp v1.7.1 (tiny.en), FFmpeg, Node 22 slim
# =============================================================================

# ─── Stage 1: Build whisper.cpp from source ───────────────────────────────────
FROM node:22-bookworm-slim AS whisper-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make g++ wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /whisper
RUN git clone https://github.com/ggml-org/whisper.cpp.git . && git checkout v1.7.1
RUN make -j$(nproc)

WORKDIR /whisper/models
RUN sh ./download-ggml-model.sh tiny.en

# ─── Stage 2: Install production deps only ────────────────────────────────────
FROM node:22-bookworm-slim AS prod-deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --prod --no-frozen-lockfile

# ─── Stage 3: Build TypeScript ────────────────────────────────────────────────
FROM prod-deps AS build

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --no-frozen-lockfile --ignore-scripts
RUN pnpm build

# ─── Stage 4: Final slim runtime image ────────────────────────────────────────
FROM node:22-bookworm-slim AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app

# Whisper binary + model
COPY --from=whisper-build /whisper/main              /app/bin/whisper
COPY --from=whisper-build /whisper/models/ggml-tiny.en.bin \
                          /app/data/libs/whisper/models/ggml-tiny.en.bin

# App
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build     /app/dist         ./dist
COPY static ./static
COPY package.json ./

# ── Runtime env defaults ──────────────────────────────────────────────────────
ENV DATA_DIR_PATH=/app/data
ENV DOCKER=true
ENV PORT=3123

# Whisper
ENV WHISPER_BINARY=/app/bin/whisper
ENV WHISPER_MODEL_PATH=/app/data/libs/whisper/models/ggml-tiny.en.bin
ENV WHISPER_MODEL=tiny.en

# External Kokoro TTS
ENV KOKORO_API_URL=https://kokoro-tts-tfeq.onrender.com
ENV KOKORO_VOICE=af_heart
ENV KOKORO_SPEED=1
ENV KOKORO_LANG_CODE=a

# Supabase — set these at runtime (Render env vars)
ENV SUPABASE_URL=
ENV SUPABASE_SERVICE_KEY=
ENV SUPABASE_BUCKET=videos

ENV NODE_OPTIONS=--max-old-space-size=200

EXPOSE 3123
CMD ["pnpm", "start"]
