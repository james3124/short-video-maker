# =============================================================================
# Dockerfile.ultra — ~270MB final image
# Removes: Remotion, Chromium, kokoro-js (uses external Kokoro API instead)
# Keeps:   whisper.cpp (tiny.en), FFmpeg, Node 22 slim
# =============================================================================

# ─── Stage 1: Build whisper.cpp from source ───────────────────────────────────
FROM node:22-bookworm-slim AS whisper-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make g++ wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /whisper
RUN git clone https://github.com/ggml-org/whisper.cpp.git . && git checkout v1.7.1
# Remove -march=native/-mtune=native from Makefile so binary runs on any x86-64 CPU
RUN sed -i 's/-march=native//g; s/-mtune=native//g' Makefile && \
    make -j$(nproc) main
WORKDIR /whisper/models
RUN sh ./download-ggml-model.sh tiny.en

# ─── Stage 2: Install production deps only ────────────────────────────────────
FROM node:22-bookworm-slim AS prod-deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app
COPY package.json ./
# Only production deps — skips vitest/vite/esbuild/rollup entirely
RUN pnpm install --prod --no-frozen-lockfile

# ─── Stage 3: Compile TypeScript (minimal — only tsc needed) ──────────────────
FROM node:22-bookworm-slim AS build

# Install only typescript + @types — no vitest, no vite, no esbuild, no rollup
RUN npm install -g typescript rimraf --no-fund --no-audit

WORKDIR /app
# @types/* are in prod deps (see package.json) — no separate install needed
COPY --from=prod-deps /app/node_modules ./node_modules
COPY package.json tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN tsc --project tsconfig.build.json

# ─── Stage 4: Final slim runtime image ────────────────────────────────────────
FROM node:22-bookworm-slim AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app

# Whisper binary + model
COPY --from=whisper-build /whisper/main              /app/bin/whisper
COPY --from=whisper-build /whisper/models/ggml-tiny.en.bin \
                          /app/data/libs/whisper/models/ggml-tiny.en.bin

# App
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build     /app/dist         ./dist
COPY static ./static
COPY package.json ./

# ── Runtime env defaults ──────────────────────────────────────────────────────
ENV DATA_DIR_PATH=/app/data
ENV DOCKER=true
ENV PORT=3123

ENV WHISPER_BINARY=/app/bin/whisper
ENV WHISPER_MODEL_PATH=/app/data/libs/whisper/models/ggml-tiny.en.bin
ENV WHISPER_MODEL=tiny.en

ENV KOKORO_API_URL=https://kokoro-tts-tfeq.onrender.com
ENV KOKORO_VOICE=af_heart
ENV KOKORO_SPEED=1
ENV KOKORO_LANG_CODE=a

ENV SUPABASE_URL=
ENV SUPABASE_SERVICE_KEY=
ENV SUPABASE_BUCKET=videos

ENV NODE_OPTIONS=--max-old-space-size=200

EXPOSE 3123
CMD ["node", "dist/index.js"]
