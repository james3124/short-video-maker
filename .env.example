# ── Required ───────────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=videos

# ── Kokoro TTS (your external server) ─────────────────────────────────────────
KOKORO_API_URL=https://kokoro-tts-tfeq.onrender.com
KOKORO_VOICE=af_heart
KOKORO_SPEED=1
KOKORO_LANG_CODE=a

# ── Optional ───────────────────────────────────────────────────────────────────
PORT=3123
LOG_LEVEL=info
WHISPER_VERBOSE=false
WHISPER_MODEL=tiny.en

# Set only for local dev (pre-set in Docker)
# WHISPER_BINARY=./data/libs/whisper/main
# WHISPER_MODEL_PATH=./data/libs/whisper/models/ggml-tiny.en.bin
# DATA_DIR_PATH=./data
